---
// src/pages/index.astro

// IMPORTANTE: Mantenemos la importación de tus estilos globales para que Tailwind funcione
import "../styles/global.css";
---

<html lang="es" class="h-full scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Acceso al Portal | APRENDE+ IPG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="min-h-screen bg-slate-50 lg:bg-white font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-indigo-500/10 selection:text-indigo-600"
  >
    <div
      class="flex flex-col lg:flex-row min-h-screen w-full relative overflow-hidden"
    >
      <div
        class="hidden lg:flex lg:w-1/2 relative bg-slate-950 items-center justify-center p-16 overflow-hidden border-r border-slate-900/50 shadow-[20px_0_40px_rgba(0,0,0,0.1)] z-10"
      >
        <div class="absolute inset-0 z-0 opacity-50">
          <div
            class="absolute top-[-10%] left-[-10%] w-[80%] h-[80%] bg-gradient-to-br from-indigo-600 to-blue-600 rounded-full blur-[140px] animate-aurora-slow"
          >
          </div>
          <div
            class="absolute bottom-[-10%] right-[-10%] w-[70%] h-[70%] bg-gradient-to-tr from-violet-600 to-fuchsia-600 rounded-full blur-[140px] animate-aurora-delayed"
          >
          </div>
        </div>

        <div
          class="relative z-20 w-full max-w-xl flex flex-col justify-between h-full animate-fade-in-up"
        >
          <div class="self-start">
            <div
              class="inline-flex items-center gap-3 bg-white/5 backdrop-blur-xl px-5 py-2.5 rounded-full border border-white/10 shadow-2xl"
            >
              <span class="flex h-2.5 w-2.5 relative">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"
                ></span>
              </span>
              <span
                class="text-[11px] font-bold tracking-[0.2em] text-slate-300 uppercase"
                >Centro de Recursos de Apoyo Académico IPG</span
              >
            </div>
          </div>

          <div class="my-auto py-12">
            <h1
              class="text-5xl xl:text-6xl font-extrabold tracking-tight text-white leading-[1.15] mb-6 drop-shadow-lg"
            >
              Encuentra <br />recursos académicos en<br />
              <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-blue-300 to-teal-200"
              >
                Aprende+.
              </span>
            </h1>

            <p
              class="text-lg text-slate-300 font-light max-w-md leading-relaxed mb-12"
            >
              Bienvenido a <strong class="text-white font-semibold"
                >APRENDE+</strong
              >, el ecosistema digital diseñado para el desarrollo de
              competencias estratégicas y autogestión en IPG.
            </p>

            <div class="space-y-6">
              <div class="flex items-center gap-5 group">
                <div
                  class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-indigo-300 group-hover:bg-indigo-500 group-hover:text-white group-hover:border-indigo-400 transition-all duration-300 shadow-lg"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                    ></path></svg
                  >
                </div>
                <p
                  class="text-slate-200 font-medium text-[15px] group-hover:text-white transition-colors"
                >
                  Materiales y multimedia disponible para su
                </p>
              </div>

              <div class="flex items-center gap-5 group">
                <div
                  class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-blue-300 group-hover:bg-blue-500 group-hover:text-white group-hover:border-blue-400 transition-all duration-300 shadow-lg"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path></svg
                  >
                </div>
                <p
                  class="text-slate-200 font-medium text-[15px] group-hover:text-white transition-colors"
                >
                  Estrategias avanzadas de autogestión académica y tiempo
                </p>
              </div>
            </div>
          </div>

          <div
            class="pt-8 border-t border-white/10 flex justify-between items-center opacity-60"
          >
            <span
              class="text-xs tracking-widest text-slate-400 font-semibold uppercase"
              >V1.0 • Luis Rivera</span
            >
            <span class="text-xl font-black text-white tracking-tighter"
              >IPG</span
            >
          </div>
        </div>
      </div>

      <div
        class="absolute inset-0 bg-gradient-to-br from-indigo-50 via-slate-50 to-blue-50 lg:hidden -z-10"
      >
      </div>
      <div
        class="absolute top-0 right-0 w-64 h-64 bg-indigo-200/40 rounded-full blur-[80px] lg:hidden -z-10"
      >
      </div>

      <div
        class="w-full lg:w-1/2 flex items-center justify-center p-4 sm:p-8 lg:p-16 min-h-screen lg:min-h-0 relative z-10"
      >
        <div
          class="w-full max-w-[420px] flex flex-col justify-between bg-white/80 backdrop-blur-2xl lg:bg-transparent lg:backdrop-blur-none p-8 sm:p-10 lg:p-0 rounded-[2rem] lg:rounded-none shadow-[0_8px_30px_rgb(0,0,0,0.04)] lg:shadow-none ring-1 ring-slate-900/5 lg:ring-0"
        >
          <div
            class="text-center mb-10 animate-fade-in-up"
            style="animation-delay: 0.1s;"
          >
            <div
              class="w-24 h-24 bg-white rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-xl shadow-slate-200/50 border border-slate-100 transform transition-all duration-500 hover:scale-105"
            >
              <img
                src="/favicon.svg"
                alt="Logo IPG"
                class="w-16 h-16 object-contain drop-shadow-sm"
              />
            </div>

            <h2
              class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3"
            >
              Ingresar a Aprende+
            </h2>
            <p class="text-slate-500 font-medium text-sm sm:text-base">
              Autentícate utilizando tu cuenta corporativa
            </p>
          </div>

          <div
            class="space-y-6 animate-fade-in-up"
            style="animation-delay: 0.2s;"
          >
            <button
              id="btn-google-sso"
              class="group w-full flex items-center justify-center gap-4 bg-white border-2 border-slate-200 hover:border-indigo-600 py-4 px-6 rounded-2xl text-slate-700 font-bold text-[15px] shadow-sm hover:bg-indigo-50/30 hover:text-indigo-700 hover:shadow-xl hover:shadow-indigo-600/10 transition-all duration-300 active:scale-[0.98]"
            >
              <svg
                class="w-5 h-5 transition-transform duration-300 group-hover:scale-110 flex-shrink-0"
                viewBox="0 0 24 24"
              >
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                ></path>
              </svg>
              Continuar con Google Workspace
            </button>

            <div
              class="bg-blue-50/80 border border-blue-100 rounded-2xl p-4 flex gap-3 items-start"
            >
              <svg
                class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              <div class="space-y-1.5">
                <h4 class="text-[13px] font-bold text-blue-900">
                  Validación Institucional
                </h4>
                <p class="text-[12px] text-blue-800/80 leading-relaxed">
                  Acceso exclusivo para cuentas <span
                    class="bg-blue-100 font-semibold px-1.5 py-0.5 rounded text-blue-900"
                    >@ipg.cl</span
                  > o <span
                    class="bg-blue-100 font-semibold px-1.5 py-0.5 rounded text-blue-900"
                    >@alumnos.ipg.cl</span
                  >.
                </p>
              </div>
            </div>
          </div>

          <div
            class="mt-10 lg:mt-12 pt-6 lg:border-t lg:border-slate-100 text-center animate-fade-in-up"
            style="animation-delay: 0.3s;"
          >
            <p
              class="text-[10px] sm:text-[11px] font-bold text-slate-400 uppercase tracking-[0.2em]"
            >
              Instituto Profesional IPG &copy; 2026
            </p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Animación Suave de Desplazamiento de Auroras */
  @keyframes aurora-slow {
    0%,
    100% {
      transform: translate(0px, 0px) scale(1);
    }
    50% {
      transform: translate(40px, -30px) scale(1.08);
    }
  }
  @keyframes aurora-delayed {
    0%,
    100% {
      transform: translate(0px, 0px) scale(1.05);
    }
    50% {
      transform: translate(-40px, 40px) scale(0.95);
    }
  }
  /* Entrada de Elementos (Stagger Artificial por Delay) */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-aurora-slow {
    animation: aurora-slow 12s ease-in-out infinite;
  }
  .animate-aurora-delayed {
    animation: aurora-delayed 16s ease-in-out infinite;
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  // Importamos el motor nativo del cliente de auth-astro
  const { signIn } = await import("auth-astro/client");

  const googleBtn = document.getElementById("btn-google-sso");
  if (googleBtn) {
    googleBtn.addEventListener("click", () => {
      signIn("google");
    });
  }
</script>
