---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Login - CRAE IPG">
  <main
    class="min-h-screen flex items-center justify-center bg-slate-50 relative overflow-hidden"
  >
    <div
      class="absolute top-[-10%] left-[-10%] w-[40rem] h-[40rem] bg-blue-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-[-10%] right-[-10%] w-[40rem] h-[40rem] bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div
      class="relative z-10 w-full max-w-md p-8 bg-white/80 backdrop-blur-xl rounded-[2rem] shadow-2xl shadow-blue-900/5 border border-slate-200/60 text-center"
    >
      <div class="mb-8">
        <span
          class="inline-flex p-4 bg-blue-50 rounded-2xl mb-5 shadow-sm border border-blue-100"
        >
          <svg
            class="w-8 h-8 text-blue-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            ></path>
          </svg>
        </span>
        <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight mb-3">
          Acceso Restringido
        </h1>
        <p class="text-slate-500 font-medium leading-relaxed">
          Inicia sesión con tu correo institucional de IPG para acceder a los
          recursos de APRENDE+.
        </p>
      </div>

      <button
        id="btn-login"
        class="w-full flex items-center justify-center gap-3 bg-white border border-slate-300 text-slate-700 px-6 py-3.5 rounded-xl font-bold hover:bg-slate-50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          ></path>
        </svg>
        Continuar con Google
      </button>

      <div
        class="mt-6 flex items-center justify-center gap-2 text-sm font-medium text-slate-400"
      >
        <span class="w-2 h-2 rounded-full bg-blue-500/50"></span>
        Exclusivo para @ipg.cl y @alumnos.ipg.cl
      </div>
    </div>
  </main>
</Layout>

<script>
  const { signIn } = await import("auth-astro/client");

  const loginBtn = document.getElementById("btn-login");
  if (loginBtn) {
    // Solución Senior: Dejar que el Middleware maneje las redirecciones post-login
    loginBtn.addEventListener("click", () => {
      signIn("google");
    });
  }
</script>
