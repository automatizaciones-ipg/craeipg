---
import "../styles/global.css";
const logoUrl     = "https://ipg.cl/wp-content/uploads/2026/06/LogoIPG_Resized.webp";
const auroraLogo  = "https://ipg.cl/wp-content/uploads/2026/06/ipg-aurora-lockup-dark-text.webp";
---

<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso al Portal | APRENDE+ IPG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="h-full bg-white font-['Plus_Jakarta_Sans',sans-serif] antialiased overflow-hidden">
    <div class="flex h-full w-full">

      

      <!-- ══════════════════════════════════════════════
           IZQUIERDA — Panel de marca (gradient vívido)
      ═══════════════════════════════════════════════════ -->
      <div class="hidden lg:flex lg:w-[54%] relative overflow-hidden" style="background: linear-gradient(145deg, #001155 0%, #003399 40%, #0055cc 70%, #1a7fff 100%);">

        <!-- Elemento geométrico giratorio de fondo -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden">
          <div class="absolute w-[680px] h-[680px] rounded-full border border-white/5 animate-ambient"></div>
          <div class="absolute w-[520px] h-[520px] rounded-full border border-white/7" style="animation: ambient-rotate 18s linear infinite reverse;"></div>
          <div class="absolute w-[360px] h-[360px] rounded-full border border-white/8 animate-ambient" style="animation-duration: 12s;"></div>
          <div class="absolute w-80 h-80 rounded-full" style="background: radial-gradient(circle, rgba(100,180,255,0.18) 0%, transparent 70%);"></div>
        </div>

        <!-- Dot grid sutil -->
        <div class="absolute inset-0 dot-grid opacity-30 pointer-events-none"></div>

        <!-- Contenido del panel de marca -->
        <div class="relative z-10 flex flex-col h-full px-14 xl:px-16 py-12 justify-between w-full">

          <!-- TOP: Logo -->
          <div class="animate-slide-up">
            <div class="flex items-center gap-3">
              <div class="h-auto w-[23%] overflow-hidden">
                <img src={logoUrl} alt="Logo" class="h-full w-full object-contain" />
              </div>
            </div>
          </div>

          <!-- CENTRO: Mensaje principal -->
          <div class="my-auto">

            <div class="space-y-1 mb-8">
              <div class="overflow-hidden">
                <h1 class="text-[3.6rem] xl:text-[4.2rem] font-black text-white leading-[1.0] animate-word-emerge delay-300">
                  Tu centro de herramientas
                </h1>
              </div>
              <div class="overflow-hidden">
                <h1 class="text-[3.6rem] xl:text-[4.2rem] font-black leading-[1.0] animate-word-emerge delay-400" style="color: transparent; background: linear-gradient(90deg, #7dd4fc, #ffffff, #a5f3fc); -webkit-background-clip: text; background-clip: text;">
                  para aprender, crecer y avanzar.
                </h1>
              </div>
            </div>

            <div class="overflow-hidden mb-12">
              <p class="text-white/50 text-base leading-relaxed max-w-sm animate-word-emerge delay-500">
                Accede a guías, materiales y herramientas diseñadas para potenciar
                tu rendimiento académico en IPG.
              </p>
            </div>

            <!-- Features — reemplazan las stats -->
            <div class="flex flex-col gap-4 animate-slide-up delay-600">

              <!-- Feature 1 -->
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center" style="background:rgba(125,212,252,0.10); border:1px solid rgba(125,212,252,0.20);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7dd4fc" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="14" rx="2"/>
                    <path d="M8 21h8M12 17v4"/>
                    <path d="M7 8h10M7 11h7"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/85 text-[13px] font-bold leading-tight">Materiales y multimedia disponible</p>
                  <p class="text-white/38 text-[11.5px] font-medium mt-0.5 leading-snug">para tu desarrollo académico en IPG</p>
                </div>
              </div>

              <!-- Separador -->
              <div class="w-full h-px" style="background:linear-gradient(90deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.03) 100%);"></div>

              <!-- Feature 2 -->
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center" style="background:rgba(165,243,252,0.08); border:1px solid rgba(165,243,252,0.16);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a5f3fc" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white/85 text-[13px] font-bold leading-tight">Estrategias avanzadas de autogestión</p>
                  <p class="text-white/38 text-[11.5px] font-medium mt-0.5 leading-snug">académica y administración del tiempo</p>
                </div>
              </div>

            </div>
          </div>

          <!-- BOTTOM: Firma -->
          <div class="animate-slide-up delay-700">
            <div class="border-t border-white/10 pt-6 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full" style="background:rgba(125,212,252,0.45);"></div>
                <span class="text-white/25 text-[10px] font-bold tracking-[0.2em] uppercase">V1.0 · Luis Rivera</span>
              </div>
              <span class="text-white/25 text-[10px] font-bold tracking-[0.2em] uppercase">IPG © 2026</span>
            </div>
          </div>

        </div>
      </div>

      <!-- ══════════════════════════════════════════════
           DERECHA — Formulario de acceso (blanco puro)
      ═══════════════════════════════════════════════════ -->
      <div class="flex-1 flex items-center justify-center bg-white px-6 py-10 relative">

        <!-- Orbe de acento muy sutil -->
        <div class="absolute top-0 right-0 w-96 h-96 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(0,51,153,0.04) 0%, transparent 70%);"></div>

        <!-- Línea decorativa izquierda -->
        <div class="absolute left-0 top-[10%] bottom-[10%] w-px bg-gradient-to-b from-transparent via-slate-200 to-transparent hidden lg:block"></div>

        <div class="relative z-10 w-full max-w-[400px] flex flex-col items-center">

          <!-- Logo aurora IPG — siempre visible -->
          <div class="flex justify-center mb-10 w-full">
            <img
              src={auroraLogo}
              alt="Instituto Profesional IPG"
              class="h-24 w-auto object-contain"
              loading="eager"
            />
          </div>

          <!-- Cabecera del formulario -->
          <div class="w-full mb-10 animate-slide-up">
            <h2 class="text-[2rem] font-black text-slate-900 leading-tight mb-2 text-center">
              Bienvenido a
              <span class="text-gradient-brand">APRENDE+</span>
            </h2>
            <p class="text-slate-500 text-[15px] leading-relaxed">
              Inicia sesión con tu cuenta institucional IPG para acceder a todos los recursos.
            </p>
          </div>

          <!-- Login -->
          <div class="w-full space-y-5 animate-slide-up delay-200">

            <!-- Divider elegante -->
            <div class="flex items-center gap-4">
              <div class="flex-1 h-px bg-slate-100"></div>
              <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">Autenticación Google</span>
              <div class="flex-1 h-px bg-slate-100"></div>
            </div>

            <!-- Botón Google -->
            <button
              id="btn-google-sso"
              class="group w-full relative overflow-hidden flex items-center justify-center gap-3.5 px-6 py-4 rounded-2xl text-[15px] font-semibold cursor-pointer transition-all duration-300
                     bg-white border-2 border-slate-200 text-slate-800
                     hover:border-[#003399] hover:shadow-[0_8px_40px_rgba(0,51,153,0.15)] hover:bg-white
                     active:scale-[0.98]"
            >
              <div class="absolute inset-0 -translate-x-full group-hover:animate-[shimmer_1.4s_ease-in-out] bg-gradient-to-r from-transparent via-blue-50/60 to-transparent pointer-events-none"></div>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              <span>Continuar con Google</span>
            </button>

            <!-- Mensaje de error de autenticación (oculto por defecto) -->
            <p id="sso-error" role="alert" class="hidden text-[12px] font-semibold text-red-600 text-center"></p>

            <!-- Nota de dominio -->
            <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-50/70 border border-blue-100">
              <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <div>
                <p class="text-[12px] font-semibold text-slate-700">Acceso exclusivo para cuentas IPG</p>
                <p class="text-[11px] text-slate-500 mt-0.5 leading-relaxed">
                  Solo dominios
                  <code class="mx-1 px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 font-mono text-[10px]">@ipg.cl</code>
                  y
                  <code class="mx-1 px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 font-mono text-[10px]">@alumnos.ipg.cl</code>
                </p>
              </div>
            </div>
          </div>

          <!-- Footer: logo IPG — visible en todos los dispositivos -->
          <div class="w-full mt-10 flex flex-col items-center gap-3 animate-slide-up delay-400">
            <div class="w-full h-px bg-slate-100"></div>
            <img
              src={logoUrl}
              alt="Instituto Profesional IPG"
              class="h-8 w-auto object-contain opacity-55"
              loading="lazy"
            />
            <p class="text-[10px] text-slate-300 tracking-[0.15em] uppercase">© 2026 Instituto Profesional IPG</p>
          </div>

        </div>
      </div>

    </div>
  </body>
</html>

<script>
  const btn = document.getElementById("btn-google-sso");
  const label = btn?.querySelector("span");
  const errEl = document.getElementById("sso-error");
  const original = label?.textContent ?? "Continuar con Google";

  btn?.addEventListener("click", async () => {
    if (btn.hasAttribute("disabled")) return;
    btn.setAttribute("disabled", "true");
    btn.classList.add("opacity-70", "cursor-wait");
    if (label) label.textContent = "Conectando…";
    errEl?.classList.add("hidden");

    try {
      const { signIn } = await import("auth-astro/client");
      await signIn("google");
      // signIn redirige al flujo de Google; si vuelve aquí es por error.
    } catch (err) {
      console.error("Error al iniciar sesión:", err instanceof Error ? err.message : err);
      if (label) label.textContent = original;
      btn.removeAttribute("disabled");
      btn.classList.remove("opacity-70", "cursor-wait");
      if (errEl) {
        errEl.textContent = "No se pudo iniciar sesión. Revisa tu conexión e intenta de nuevo.";
        errEl.classList.remove("hidden");
      }
    }
  });
</script>
