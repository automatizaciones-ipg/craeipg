---
import Layout from "../layouts/Layout.astro";
import ResourceGrid from "../components/ResourceGrid.tsx";
import WelcomeSection from "../components/WelcomeSection.tsx";
import HeroSearch from "../components/HeroSearch.tsx";

const POPULAR = [
  { label: 'Plantilla APA 7',       href: '/normas-apa' },
  { label: 'Método Pomodoro',        href: '/gestion-tiempo' },
  { label: 'Guía CRAI',             href: '/tecnicas-estudio' },
  { label: 'Herramientas digitales', href: '/herramientas-digitales' },
];
---

<style>
  /* Animación flotante del badge — no tiene equivalente Tailwind sin plugin */
  @keyframes h-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }
  .h-float { animation: h-float 4s ease-in-out infinite; }
</style>

<Layout title="CRAE — Centro de Recursos Estudiantiles IPG">

  <!-- ══════════════════ HERO ══════════════════ -->
  <section class="
    bg-white
    min-h-[calc(100vh-80px)]
    flex items-center
    pt-14 pb-24
  ">
    <div class="w-full max-w-[1240px] mx-auto px-10">

      <!-- Grid dos columnas -->
      <div class="
        flex items-center gap-14
        xl:gap-14
        lg:gap-10
        max-lg:flex-col max-lg:items-start max-lg:gap-12
      ">

        <!-- ─── COLUMNA IZQUIERDA ─── -->
        <div class="flex-none w-1/2 max-w-[50%] max-lg:flex-none max-lg:w-full max-lg:max-w-full">

          <!-- Headline -->
          <h1 class="font-black leading-[1.04] tracking-[-2px] text-slate-900 mb-5"
              style="font-size: clamp(2.6rem, 3.8vw, 4rem);">
            Encuentra el<br>
            recurso<br>
            <span class="text-blue-700">perfecto para ti.</span>
          </h1>

          <!-- Subtítulo -->
          <p class="text-[15px] text-slate-500 leading-[1.76] mb-8 max-w-[400px]">
            Busca y descarga guías, plantillas, normativas APA y material
            exclusivo diseñado para potenciar tu aprendizaje en IPG.
          </p>

          <!-- Buscador -->
          <div class="mb-[22px] relative z-10">
            <HeroSearch client:load />
          </div>

          <!-- Tags populares -->
          <div class="flex items-center flex-wrap gap-2">
            <span class="text-xs text-slate-400 font-semibold shrink-0">Populares:</span>
            {POPULAR.map(t => (
              <a href={t.href}
                 class="
                   inline-block px-[14px] py-[6px]
                   bg-white border border-slate-200 rounded-full
                   text-xs font-bold text-slate-600 no-underline whitespace-nowrap
                   transition-all duration-[180ms]
                   hover:border-blue-700 hover:text-blue-700 hover:bg-blue-50
                 ">
                {t.label}
              </a>
            ))}
          </div>

        </div>
        <!-- ─── FIN IZQUIERDA ─── -->

        <!-- ─── COLUMNA DERECHA — card + imagen bleed ─── -->
        <div class="
          flex-1 relative mt-[100px]
          max-lg:w-full max-lg:max-w-[520px] max-lg:self-center max-lg:mt-16
          max-sm:max-w-full
        ">

          <!-- Card principal: overflow visible permite que la imagen sobresalga por arriba -->
          <div class="relative overflow-visible aspect-[4/3] rounded-[26px]"
               style="box-shadow: 0 24px 70px rgba(0,0,0,0.10), 0 6px 20px rgba(0,0,0,0.06);">

            <!-- Fondo del card: overflow hidden recorta los decorativos -->
            <div class="absolute inset-0 rounded-[26px] overflow-hidden bg-[#f0f7ff]">

              <!-- Glow azul vívido — esquina superior derecha (igual que referencia) -->
              <div class="absolute -top-[60px] -right-[60px] w-[320px] h-[320px] rounded-full pointer-events-none"
                   style="background: radial-gradient(circle, rgba(59,130,246,0.55) 0%, rgba(99,170,255,0.35) 30%, rgba(147,197,253,0.18) 55%, transparent 72%);"></div>

              <!-- Dot grid sutil -->
              <div class="absolute inset-0 pointer-events-none"
                   style="background-image: radial-gradient(rgba(0,51,153,0.065) 1px, transparent 1px); background-size: 22px 22px;"></div>

            </div>

            <!-- Imagen: pies anclados al fondo, 38% sobresale por arriba del card -->
            <img
              src="https://ipg.cl/wp-content/uploads/2026/06/Portada_Aprendemas_Estudiantes.webp"
              alt="Estudiantes IPG usando APRENDE+"
              class="
                absolute bottom-0 left-1/2 -translate-x-1/2
                h-[138%] w-auto max-w-[108%]
                object-contain object-bottom
                z-[2] pointer-events-none block
              "
              loading="eager"
              decoding="async"
            />

            <!-- Badge flotante — esquina inferior izquierda -->
            <div class="h-float absolute -bottom-[18px] -left-4 z-10">
              <div class="
                bg-white rounded-[18px] py-[10px] pr-[14px] pl-[10px]
                flex items-center gap-[10px] whitespace-nowrap
                shadow-[0_10px_36px_rgba(0,0,0,0.11),0_2px_8px_rgba(0,0,0,0.06)]
              ">
                <!-- Avatar -->
                <div class="relative shrink-0">
                  <div class="
                    w-[38px] h-[38px] rounded-full
                    bg-gradient-to-br from-blue-100 to-blue-200
                    border-[2.5px] border-white
                    flex items-center justify-center
                    text-[14px] font-black text-blue-700
                    shadow-[0_2px_10px_rgba(29,78,216,0.18)]
                  " style="font-family:'Plus Jakarta Sans',sans-serif;">M</div>
                  <!-- Punto online -->
                  <div class="
                    absolute bottom-0 right-0
                    w-[10px] h-[10px] rounded-full
                    bg-green-500 border-2 border-white
                    shadow-[0_0_0_3px_rgba(34,197,94,0.2)]
                  "></div>
                </div>
                <!-- Texto -->
                <div>
                  <p class="text-[12px] font-extrabold text-slate-900 leading-[1.2]">Martina R.</p>
                  <p class="text-[10px] text-slate-500 mt-[2px] font-medium">Leyendo Normas APA · ahora</p>
                </div>
              </div>
            </div>

          </div>
          <!-- fin card -->

        </div>
        <!-- ─── FIN DERECHA ─── -->

      </div>
    </div>
  </section>
  <!-- ═══ FIN HERO ═══ -->

  <WelcomeSection client:visible />
  <ResourceGrid  client:visible />

</Layout>
