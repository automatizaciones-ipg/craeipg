# ============================================================
# APRENDE+ IPG — Plantilla de Variables de Entorno
# Copia este archivo como ".env" y completa los valores reales
# ============================================================

AUTH_SECRET=GENERAR_CON: node -e "require('crypto').randomBytes(32).toString('base64url')"
AUTH_TRUST_HOST=true

GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

GOOGLE_DRIVE_CLIENT_EMAIL=cuenta@proyecto.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

MOODLE_PASSWORD=ipg.2025
EMAIL_PASSWORD=alumnos.2026

# Emails de administrador separados por coma (sin espacios entre ellos).
# Si no se define, el fallback es luis.rivera@ipg.cl.
# En producción: wrangler secret put ADMIN_EMAILS
ADMIN_EMAILS=luis.rivera@ipg.cl
