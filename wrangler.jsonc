{
  "main": "dist/_worker.js/index.js",
  "name": "craeipg",
  "compatibility_date": "2026-03-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  /*
   * VARS: solo valores no-secretos (visibles en este archivo).
   * Para secretos (claves, tokens, contraseñas) usa:
   *   wrangler secret put NOMBRE_VARIABLE
   * Secretos requeridos en producción:
   *   - AUTH_SECRET
   *   - GOOGLE_CLIENT_ID
   *   - GOOGLE_CLIENT_SECRET
   *   - GOOGLE_DRIVE_PRIVATE_KEY
   *   - GOOGLE_DRIVE_CLIENT_EMAIL
   *   - MOODLE_PASSWORD
   *   - EMAIL_PASSWORD
   *   - ADMIN_EMAILS  (lista separada por comas, ej: "luis.rivera@ipg.cl,otro@ipg.cl")
   */
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "AUTH_URL": "https://craeipg.automatizaciones-730.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "CRAE_KV",
      "id": "5bc1c7b0fdd544778749ce8a978d30bf"
    }
  ]
}
