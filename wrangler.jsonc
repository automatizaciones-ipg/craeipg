    "GOOGLE_DRIVE_CLIENT_EMAIL": "aprendemas-drive-downloader@aprendemas-ipg-auth.iam.gserviceaccount.com"
  },
  "kv_namespaces": [
    {
      "binding": "CRAE_KV",
